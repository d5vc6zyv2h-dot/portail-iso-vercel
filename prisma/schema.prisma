generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id          Int          @id @default(autoincrement())
  name        String
  email       String       @unique
  password    String
  role        String       @default("Utilisateur")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  auditLogs   AuditLog[]
  evaluations Evaluation[]
  rapports    Rapport[]
  risques     Risque[]
}

model Question {
  id                 Int                  @id @default(autoincrement())
  texte              String               @db.Text
  categorie          String
  type               String               @default("choix")
  active             Boolean              @default(true)
  questionParentId   Int?
  evaluations        EvaluationQuestion[]
  questionParent     Question?            @relation("QuestionDependante", fields: [questionParentId], references: [id])
  questionsSuivantes Question[]           @relation("QuestionDependante")
  reponses           Reponse[]
  risques            Risque[]

  @@index([questionParentId], map: "Question_questionParentId_fkey")
}

model Evaluation {
  id          Int                  @id @default(autoincrement())
  userId      Int?
  statut      String               @default("en_cours")
  supprimee   Boolean              @default(false)
  supprimeeAt DateTime?
  score       Float?
  niveau      String?
  conclusion  String?              @db.Text
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User?                @relation(fields: [userId], references: [id])
  questions   EvaluationQuestion[]
  rapport     Rapport?
  reponses    Reponse[]
  risques     Risque[]

  @@index([userId], map: "Evaluation_userId_fkey")
}

model Reponse {
  id           Int        @id @default(autoincrement())
  evaluationId Int
  questionId   Int
  choix        String?
  details      String?    @db.Text
  score        Float?
  createdAt    DateTime   @default(now())
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, questionId])
  @@index([questionId], map: "Reponse_questionId_fkey")
}

model Risque {
  id            Int        @id @default(autoincrement())
  evaluationId  Int
  questionId    Int?
  userId        Int?
  titre         String
  description   String?    @db.Text
  vulnerabilite String?    @db.Text
  consequence   String?    @db.Text
  probabilite   Int?
  impact        Int?
  criticite     Int?
  niveau        String?
  statut        String     @default("Identifié")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  mesures       Mesure[]
  evaluation    Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  question      Question?  @relation(fields: [questionId], references: [id])
  user          User?      @relation(fields: [userId], references: [id])

  @@index([evaluationId], map: "Risque_evaluationId_fkey")
  @@index([questionId], map: "Risque_questionId_fkey")
  @@index([userId], map: "Risque_userId_fkey")
}

model Mesure {
  id          Int       @id @default(autoincrement())
  risqueId    Int
  type        String
  description String    @db.Text
  responsable String?
  priorite    String?
  echeance    DateTime?
  statut      String    @default("À mettre en œuvre")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  risque      Risque    @relation(fields: [risqueId], references: [id], onDelete: Cascade)

  @@index([risqueId], map: "Mesure_risqueId_fkey")
}

model Rapport {
  id           Int        @id @default(autoincrement())
  evaluationId Int        @unique
  userId       Int?
  titre        String
  conclusion   String     @db.Text
  supprimee    Boolean    @default(false)
  supprimeeAt  DateTime?
  createdAt    DateTime   @default(now())
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id])

  @@index([userId], map: "Rapport_userId_fkey")
}

model EvaluationQuestion {
  id           Int        @id @default(autoincrement())
  evaluationId Int
  questionId   Int
  ordre        Int
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, questionId])
  @@index([questionId], map: "EvaluationQuestion_questionId_fkey")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  action      String
  description String   @db.Text
  details     String?  @db.Text
  signature   String   @db.VarChar(255)
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}
